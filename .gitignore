# Python build output. Anchored to the repo root so it does not also swallow
# frontend/src/lib/ (the shadcn cn() helper lives there, and an unanchored
# "lib/" kept it out of git entirely - a fresh clone could not build the
# frontend).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# Project specific - backups and temporary files
backups/
old_working/
src_failed/
*.lgd-nfy0
.lgd-nfy0

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.old

# App state file
src/state/state.json

# Rig state - per-installation wiring, bootstrapped from src/config/rig.yaml
src/state/rig.json

# Deployment secrets (template committed as diuna-backend.env.example)
deploy/diuna-backend.env

# Per-machine LED hardware override - describes what is physically wired to
# THIS Raspberry Pi. src/config/hardware.yaml stays the committed rig; this file
# exists only on a machine wired differently (e.g. the Pi 5's SPI test strip).
src/config/hardware.local.yaml
