#pragma once

// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored and must never be committed.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// mDNS hostname of the RPi5 running the Diuna backend - NOT the ".local" suffix,
// NOT an IP. This is the Pi's system hostname (`hostname -s` on the Pi; the
// Raspberry Pi OS default is "raspberrypi", advertised automatically by the
// avahi-daemon that ships with it). Resolved to a live IP at runtime via
// ESPmDNS, so a DHCP lease change on the Pi no longer requires reflashing.
#define RPI_MDNS_HOSTNAME "raspberrypi"
#define RPI_PORT 8000

// Must match DIUNA_NODE_SHARED_SECRET in the RPi5 backend's environment.
// Sent as the X-Node-Secret header on every heartbeat so an arbitrary
// device on the LAN can't register itself as a node.
#define NODE_SHARED_SECRET "diuna-dev-secret"
